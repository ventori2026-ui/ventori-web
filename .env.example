# URL pública del sitio. En Vercel se define con el dominio de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Envío del formulario de contacto (https://resend.com).
# Sin estas tres variables el formulario responde 503 de forma controlada.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Ventori <web@ventori.com.co>"
CONTACT_FROM_EMAIL=
# Buzón que recibe los mensajes del formulario.
CONTACT_TO_EMAIL=
